{
    "name": "mage-os/module-abandoned-cart",
    "description": "Abandoned cart reminder e-mail",
    "type": "magento2-module",
    "license": "OSL-3.0",
    "require": {
        "php": "~8.3.0||~8.4.0||~8.5.0",
        "magento/framework": "^103.0.9",
        "magento/module-config": "^101.2.9",
        "magento/module-cron": "^100.4.9",
        "magento/module-email": "^101.1.9",
        "magento/module-newsletter": "^100.4.9",
        "magento/module-quote": "^101.2.9",
        "magento/module-sales": "^103.0.9",
        "magento/module-store": "^101.1.9"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "MageOS\\AbandonedCart\\": ""
        }
    },
    "require-dev": {
        "bitexpert/phpstan-magento": "^0.44",
        "magento/magento-coding-standard": "^41",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^13.4"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://mirror.mage-os.org/"
        }
    ],
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "magento/composer-dependency-version-audit-plugin": false,
            "magento/magento-composer-installer": false
        }
    }
}
