<?php
/**
 * Report of the reminders sent, followed and turned into orders, and form that sends a reminder as a test.
 *
 * @var \Magento\Backend\Block\Template $block
 * @var \Magento\Framework\Escaper $escaper
 */

/** @var \MageOS\AbandonedCart\ViewModel\Report $report */
$report = $block->getData('view_model');
$rows = $report->getRows();
?>
<p>
    <?= $escaper->escapeHtml(__('Period:')) ?>
    <?php foreach (\MageOS\AbandonedCart\ViewModel\Report::PERIODS as $days): ?>
        <?php if ($days === $report->getDays()): ?>
            <strong><?= $escaper->escapeHtml(__('%1 days', $days)) ?></strong>
        <?php else: ?>
            <a href="<?= $escaper->escapeUrl($block->getUrl('*/*/*', ['days' => $days])) ?>">
                <?= $escaper->escapeHtml(__('%1 days', $days)) ?>
            </a>
        <?php endif; ?>
    <?php endforeach; ?>
</p>
<?php if (!$rows): ?>
    <p><?= $escaper->escapeHtml(__('No reminder was sent in this period.')) ?></p>
<?php else: ?>
    <table class="data-grid">
        <thead>
        <tr>
            <th class="data-grid-th"><?= $escaper->escapeHtml(__('Reminder')) ?></th>
            <th class="data-grid-th"><?= $escaper->escapeHtml(__('Sent')) ?></th>
            <th class="data-grid-th"><?= $escaper->escapeHtml(__('Cart link followed')) ?></th>
            <th class="data-grid-th"><?= $escaper->escapeHtml(__('Orders')) ?></th>
            <th class="data-grid-th"><?= $escaper->escapeHtml(__('Revenue')) ?></th>
        </tr>
        </thead>
        <tbody>
        <?php foreach ($rows as $step => $row): ?>
            <tr>
                <td>
                    <?= $escaper->escapeHtml($step === 'total' ? __('Total') : __('Reminder %1', $step)) ?>
                </td>
                <td><?= (int) $row['sent'] ?></td>
                <td>
                    <?= (int) $row['clicked'] ?>
                    (<?= $escaper->escapeHtml($report->rate($row['clicked'], $row['sent'])) ?>)
                </td>
                <td>
                    <?= (int) $row['orders'] ?>
                    (<?= $escaper->escapeHtml($report->rate($row['orders'], $row['sent'])) ?>)
                </td>
                <td><?= $escaper->escapeHtml($report->price($row['revenue'])) ?></td>
            </tr>
        <?php endforeach; ?>
        </tbody>
    </table>
    <p>
        <?= $escaper->escapeHtml(__(
            'An order is credited to the last reminder its cart received, whether or not the link was followed.'
            . ' Revenue is the grand total in base currency.'
        )) ?>
    </p>
<?php endif; ?>
<form action="<?= $escaper->escapeUrl($block->getUrl('*/*/sendTest')) ?>" method="post">
    <input type="hidden" name="form_key" value="<?= $escaper->escapeHtmlAttr($block->getFormKey()) ?>">
    <fieldset class="admin__fieldset">
        <legend class="admin__legend"><span><?= $escaper->escapeHtml(__('Send a Test E-mail')) ?></span></legend>
        <div class="admin__field">
            <label class="admin__field-label" for="abandoned-cart-test-step">
                <span><?= $escaper->escapeHtml(__('Reminder')) ?></span>
            </label>
            <div class="admin__field-control">
                <select class="admin__control-select" id="abandoned-cart-test-step" name="step">
                    <?php foreach ([1, 2, 3] as $step): ?>
                        <option value="<?= (int) $step ?>">
                            <?= $escaper->escapeHtml(__('Reminder %1', $step)) ?>
                        </option>
                    <?php endforeach; ?>
                </select>
            </div>
        </div>
        <div class="admin__field">
            <label class="admin__field-label" for="abandoned-cart-test-store">
                <span><?= $escaper->escapeHtml(__('Store View')) ?></span>
            </label>
            <div class="admin__field-control">
                <select class="admin__control-select" id="abandoned-cart-test-store" name="store">
                    <?php foreach ($report->getStores() as $storeId => $storeName): ?>
                        <option value="<?= (int) $storeId ?>"><?= $escaper->escapeHtml($storeName) ?></option>
                    <?php endforeach; ?>
                </select>
                <div class="admin__field-note">
                    <?= $escaper->escapeHtml(__(
                        'Sent to your address, %1, with the saved settings and a few products of the store view as'
                        . ' the cart. Its links open the cart page.',
                        $report->getAdminEmail()
                    )) ?>
                </div>
            </div>
        </div>
        <div class="admin__field">
            <div class="admin__field-control">
                <button type="submit" class="action-default primary">
                    <span><?= $escaper->escapeHtml(__('Send')) ?></span>
                </button>
            </div>
        </div>
    </fieldset>
</form>
