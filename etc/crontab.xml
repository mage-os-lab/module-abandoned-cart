<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <job name="mageos_abandoned_cart_reminders" instance="MageOS\AbandonedCart\Cron\SendReminders" method="execute">
            <schedule>*/15 * * * *</schedule>
        </job>
        <job name="mageos_abandoned_cart_purge" instance="MageOS\AbandonedCart\Cron\PurgeHistory" method="execute">
            <schedule>40 3 * * *</schedule>
        </job>
    </group>
</config>
